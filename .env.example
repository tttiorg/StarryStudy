# 复制为 .env 后填写。所有值都留空：没配置时采集器不会启动，而不是崩掉。
# 唯一读取环境的地方是 packages/shared/src/config.ts，业务代码里不要出现 process.env。

# --- 采集器（本机） ---
# CAS 登录页根地址，形如 https://cas.example.com
BB_CAS_URL=
# Blackboard 站点根地址，形如 https://bb.example.com
BB_BASE_URL=
# CAS 回跳的 service 路径，形如 /webapps/bb-sso-BBLEARN/index.jsp
BB_SERVICE_PATH=
# 学校账号，只留在本机，绝不进仓库
BB_USER=
BB_PASSWORD=
# 可选：学校专属适配器的路径微调，留空则用通用 Blackboard 流程
BB_STREAM_PATH=
BB_MYGRADES_PATH=
BB_CALENDAR_PATH=
# 采集器写云端用的令牌，必须与 Worker 的 AUTH_COLLECTOR_TOKEN 一致
COLLECTOR_TOKEN=
# 云端 API 根地址，形如 https://study.example.com
API_BASE_URL=
# 可选：手动指定 BB course_id 到学科 id 的映射（JSON 字符串）
BB_SUBJECT_MAP=

# --- Worker（云端 secret，用 wrangler secret put 设置，不要写进文件） ---
# 会话签名密钥：wrangler secret put AUTH_SECRET
# 采集器令牌：wrangler secret put AUTH_COLLECTOR_TOKEN
# 通知 webhook：wrangler secret put NOTICE_WEBHOOK_URL
