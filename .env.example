# 复制为 .env 后填写。所有值都留空：没配置时采集器不会启动，而不是崩掉。
# 唯一读取环境的地方是 packages/shared/src/config.ts，业务代码里不要出现 process.env。
# 运行采集器前先 cd 到项目根目录（有 package.json 的那一层），否则 npm 报 ENOENT。
# 只有 6 项必填：BB_CAS_URL / BB_BASE_URL / BB_USER / BB_PASSWORD / COLLECTOR_TOKEN / API_BASE_URL。
# 其余全部留空即可，采集器内置通用 Blackboard 流程的默认路径。

# --- 采集器（本机） ---
# CAS 站点根，只填「协议 + 域名」，例如 https://cas.example.com
# 别把浏览器地址栏整条复制进来：/cas/login 和 ?service=... 由采集器自己拼，
# 填完整 URL 会拼成 https://cas.example.com/cas/login?service=.../cas/login。
BB_CAS_URL=
# Blackboard 站点根，同样只填「协议 + 域名」，例如 https://bb.example.com
BB_BASE_URL=
# CAS 回跳的 service 路径；留空即用通用 Blackboard 默认值，一般不用填
BB_SERVICE_PATH=
# 学校账号，只留在本机，绝不进仓库
BB_USER=
BB_PASSWORD=
# 可选：学校专属适配器的路径微调，推荐留空（用通用 Blackboard 流程）
BB_STREAM_PATH=
BB_MYGRADES_PATH=
BB_CALENDAR_PATH=
# 采集器写云端用的令牌，必须与 Worker 的 AUTH_COLLECTOR_TOKEN 完全一致。
# 本机把 .dev.vars 里 AUTH_COLLECTOR_TOKEN 的值复制过来即可（两边对账用同一个值）。
COLLECTOR_TOKEN=
# 云端 API 根地址，只填「协议 + 域名」，例如 https://study.example.com
# 就是 wrangler.local.toml 里绑定的那个自定义域名，不要带任何路径。
API_BASE_URL=
# 可选：手动指定 BB course_id 到学科 id 的映射（JSON 字符串）。
# 课程能按 bbCourseId 自动匹配时留空；只有「未匹配学科」不为 0 时才需要填。
BB_SUBJECT_MAP=

# --- Worker（云端 secret，用 wrangler secret put 设置，不要写进文件） ---
# 会话签名密钥：wrangler secret put AUTH_SECRET
# 采集器令牌：wrangler secret put AUTH_COLLECTOR_TOKEN
# 通知 webhook：wrangler secret put NOTICE_WEBHOOK_URL
