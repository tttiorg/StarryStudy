# 复制为 .dev.vars（已被 .gitignore 排除），只用于本地 wrangler dev。
# 线上对应值一律用 wrangler secret put 设置，不写进任何文件。
# AUTH_SECRET 请填一段随机长字符串；AUTH_COLLECTOR_TOKEN 要与本机 .env 的 COLLECTOR_TOKEN 一致。

AUTH_SECRET=
AUTH_COLLECTOR_TOKEN=
NOTICE_WEBHOOK_URL=

# Worker 不再有对象存储 binding，通过 S3 兼容 API 访问 B2，这 5 项必须配置；线上同名值用
# wrangler secret put 设置，不要写进任何文件。
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
